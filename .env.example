# Host directory on the VPS. Keep this value outside the Git worktree.
SM_TECHNO_HOST_ROOT=/srv/sm-techno-test
# Default remains loopback. Set to 0.0.0.0 only for a firewall-restricted temporary check.
SM_TECHNO_FRONTEND_BIND=127.0.0.1

# Required server-only values. Replace the placeholders only in /srv/sm-techno-test/app/.env.
SM_TECHNO_CREDENTIAL_KEY=replace-with-a-generated-fernet-key
SM_TECHNO_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
